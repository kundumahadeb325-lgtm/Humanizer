# Optional: set a server-side default API key so every visitor can use the
# tool without pasting their own key. Leave unset to run in "bring your own
# key" mode (each visitor adds their key via the Settings panel; it is kept
# in their browser's localStorage and sent only on their own requests).
ANTHROPIC_API_KEY=

# Optional: model override. Defaults to claude-opus-4-8 in code.
# ANTHROPIC_MODEL=claude-opus-4-8
